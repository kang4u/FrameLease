+def last_stamp(text):
+    """The latest 'YYYY-MM-DD HH:MM' of an entry head or an amendment title in Sec. 13.2 ('' when there is none);
+    None when the heading of Sec. 13.2 is not found exactly once (both drivers' parsers stop on that too)."""
+    lines = text.split('\n')
+    starts = [i for i, ln in enumerate(lines) if ln.strip() == SEC_START]
+    if len(starts) != 1:
+        return None
+    stamps = []
+    for ln in lines[starts[0] + 1:]:
+        if ln.startswith('## '):
+            break
+        if AMEND_RE.match(ln) or ENTRY_RE.match(ln) or PHASE_ENTRY_RE.match(ln):
+            m = STAMP_RE.search(ln)
+            if m:
+                stamps.append(m.group(0))
+    return max(stamps, default='')
+
